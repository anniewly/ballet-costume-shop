# Copy to .env.local for local development, and add the same names in
# Vercel under Project Settings > Environment Variables.
# Use Stripe *test* keys (they start with sk_test_ / pk_test_).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# The site's public address, used for Stripe's return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
