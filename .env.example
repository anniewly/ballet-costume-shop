# Copy to .env.local for local development, and add the same names in
# Vercel under Project Settings > Environment Variables.
# Use a Stripe *test* secret key (it starts with sk_test_).
STRIPE_SECRET_KEY=sk_test_...
# Optional: the site's public address, used for Stripe's return URLs only when
# the browser doesn't send one. Normally the address the shopper is on is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
